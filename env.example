# Copy this file to ".env" and put your real key in it.
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use. gemini-1.5-pro has been retired by Google, so the default is a current model.
# Other options: gemini-2.5-pro (higher quality, slower), gemini-2.5-flash-lite (cheapest)
GEMINI_MODEL=gemini-2.5-flash

# Where the Streamlit frontend finds the FastAPI backend
BACKEND_URL=http://localhost:8000
